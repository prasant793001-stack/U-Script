rules_version = '2';

// U-Script: every signed-in user can read and write ONLY their own data.
// Layout: users/{uid}/items/{key}   key = "profile" or "proj_<id>"
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/items/{key} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
